# Server-only CRM follow-ups: add these to Vercel and .env.local, never VITE_*.
# OpenAI_key is supported alongside OPENAI_API_KEY. The model is always gpt-5-nano.
OpenAI_key=
OpenAI_model=gpt-5-nano
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ZeptoMail India token, with or without the Zoho-enczapikey prefix.
ZOHO_TOKEN=
# Partner-facing emails (welcome, reminders, follow-ups) come from the partner team
ZOHO_FROM_ADDRESS=partners@bncglobal.in
PUBLIC_SITE_URL=https://partners.bncglobal.in
# Optional branded follow-up details. Deadline appears only when configured (YYYY-MM-DD).
FOLLOW_UP_SUPPORT_EMAIL=wofa@bncglobal.in
FOLLOW_UP_SUPPORT_PHONE=+91 98105 75613
FOLLOW_UP_DEADLINE_DATE=
# Set this same Authentication Key in your ZeptoMail agent's Webhooks settings.
ZOHO_WEBHOOK_AUTH_KEY=
# Alternative: configure Authorization: Bearer <this value> on the webhook.
ZOHO_WEBHOOK_SECRET=

# ---- Supabase Edge Function secrets (set with: supabase secrets set NAME=value) ----
# All email goes through ZeptoMail: welcome, reminders 1-3, password reset, admin alerts, campaigns.
# ZOHO_TOKEN=                         (same ZeptoMail token as above)
# ZEPTOMAIL_API_URL=https://cpaas.zoho.in/v1.1/email
# PARTNER_FROM_ADDRESS=partners@bncglobal.in
# PARTNER_FROM_NAME=BNC LEG Partners
# NOREPLY_FROM_ADDRESS=noreply@bncglobal.in   (admin alerts)
# ADMIN_ALERT_EMAILS=summit@bncglobal.in,partners@bncglobal.in   (registration / form / voice alerts)
# CAMPAIGN_FROM_EMAIL=partners@bncglobal.in
# CAMPAIGN_FROM_NAME=BNC LEG Partners
# ONBOARDING_REMINDER_SECRET=         (header x-reminder-secret for the reminder schedule)
# WELCOME_SAFETY_NET_SINCE=2026-11-16T00:00:00Z
# PASSWORD_RESET_ALLOWED_ORIGINS=https://partners.bncglobal.in
