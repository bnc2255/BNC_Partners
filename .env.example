# Server-only CRM follow-ups: add these to Vercel and .env.local, never VITE_*.
# OpenAI_key is supported alongside OPENAI_API_KEY. The model is always gpt-5-nano.
OpenAI_key=
OpenAI_model=gpt-5-nano
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ZeptoMail India token, with or without the Zoho-enczapikey prefix.
ZOHO_TOKEN=
ZOHO_FROM_ADDRESS=noreply@bncglobal.in
PUBLIC_SITE_URL=https://partners.bncglobal.in
# Optional branded follow-up details. Deadline appears only when configured (YYYY-MM-DD).
FOLLOW_UP_SUPPORT_EMAIL=wofa@bncglobal.in
FOLLOW_UP_SUPPORT_PHONE=+91 98105 75613
FOLLOW_UP_DEADLINE_DATE=
# Set this same Authentication Key in your ZeptoMail agent's Webhooks settings.
ZOHO_WEBHOOK_AUTH_KEY=
# Alternative: configure Authorization: Bearer <this value> on the webhook.
ZOHO_WEBHOOK_SECRET=
